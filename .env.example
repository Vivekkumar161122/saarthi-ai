# ==============================================================
# Saarthi AI — Environment Configuration Template
# ==============================================================

# Optional: OpenAI API Key for GPT-4o-mini streaming
# If omitted, Saarthi uses the built-in zero-latency edge domain engine
OPENAI_API_KEY=

# Optional: Google Gemini API Key
GOOGLE_GENERATIVE_AI_API_KEY=

# Application Host & Port
PORT=3000
NODE_ENV=development
